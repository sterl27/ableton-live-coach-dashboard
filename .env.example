# Google Gemini API Key for AI coaching responses
# Get your key at: https://aistudio.google.com/apikey
# WARNING: This key is exposed in the client bundle — for personal/local use only
VITE_GEMINI_API_KEY=your_api_key_here

# Supabase — chat session persistence (optional)
# Create a project at: https://supabase.com/dashboard
# Required table: chat_sessions (id text PK, messages jsonb, mode text, area_id int, updated_at timestamptz)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# OSC Bridge — Ableton Live transport control (optional)
# Requires a WebSocket-to-OSC bridge running locally (e.g. oscbridge or TouchOSC Bridge)
VITE_OSC_BRIDGE_HOST=localhost
VITE_OSC_BRIDGE_PORT=9000
